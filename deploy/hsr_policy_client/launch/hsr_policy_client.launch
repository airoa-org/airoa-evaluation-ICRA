<?xml version="1.0"?>
<launch>
    <arg name="config_name" default="remote_policy"/>
    <arg name="policy_server_host" default="127.0.0.1"/>
    <arg name="policy_server_port" default="8000"/>
    <arg name="policy_server_api_key" default=""/>
    <arg name="update_freq" default="10"/>
    <arg name="adopted_action_chunks" default="10"/>
    <arg name="upsample" default="true"/>
    <arg name="upsample_hz" default="100"/>
    <arg name="upsample_method" default="spline"/>
    <arg name="action_smoothing" default="ema"/>
    <arg name="ema_alpha" default="0.2"/>
    <arg name="ma_window" default="5"/>
    <arg name="smooth_gripper" default="false"/>
    <arg name="smooth_base" default="false"/>
    <arg name="gripper_mode" default="hybrid"/>
    <arg name="prefetch_threshold" default="0"/>
    <arg name="save_exec_trace" default="false"/>
    <arg name="test_mode" default="true"/>


    <node name="hsr_policy_client" pkg="hsr_policy_client" type="hsr_policy.py" output="screen">
        <param name="config_name" value="$(arg config_name)"/>
        <param name="policy_server_host" value="$(arg policy_server_host)"/>
        <param name="policy_server_port" value="$(arg policy_server_port)"/>
        <param name="policy_server_api_key" value="$(arg policy_server_api_key)"/>
        <param name="adopted_action_chunks" value="$(arg adopted_action_chunks)"/>
        <param name="update_freq" value="$(arg update_freq)"/>
        <param name="upsample" value="$(arg upsample)"/>
        <param name="upsample_hz" value="$(arg upsample_hz)"/>
        <param name="upsample_method" value="$(arg upsample_method)"/>
        <param name="action_smoothing" value="$(arg action_smoothing)"/>
        <param name="ema_alpha" value="$(arg ema_alpha)"/>
        <param name="ma_window" value="$(arg ma_window)"/>
        <param name="smooth_gripper" value="$(arg smooth_gripper)"/>
        <param name="smooth_base" value="$(arg smooth_base)"/>
        <param name="gripper_mode" value="$(arg gripper_mode)"/>
        <param name="prefetch_threshold" value="$(arg prefetch_threshold)"/>
        <param name="save_exec_trace" value="$(arg save_exec_trace)"/>
        <param name="test_mode" value="$(arg test_mode)"/>
    </node>

</launch>
